# Fed-MammoBench benchmark image with GPU (ResNet50 and EfficientNetV2 variants). Built from
# the LOCAL checkout (not a git clone). Build and run through scripts/run_mammobench_docker.sh.
# Neither the images nor the ImageNet weights are baked in: the images are mounted at /data
# and torchvision caches the weights in /cache/torch (TORCH_HOME), both at run time.
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

WORKDIR /opt/FLamby
COPY . .

# Pin the image's torch/torchvision so pip never swaps them for a CPU or other-CUDA build.
RUN pip freeze | grep -E '^(torch|torchvision)==' > /tmp/constraints.txt && \
    SKLEARN_ALLOW_DEPRECATED_SKLEARN_PACKAGE_INSTALL=True \
    pip install --no-cache-dir -c /tmp/constraints.txt -e ".[mammobench,tracking]" pyyaml

# The container runs as the host user (so outputs are not root-owned): HOME must be writable.
# MAMMOBENCH_DATA is where FedMammobench looks for norm_0_1/ (the mounted images).
ENV HOME=/tmp \
    MPLCONFIGDIR=/tmp/matplotlib \
    MAMMOBENCH_DATA=/data \
    PYTHONUNBUFFERED=1

# fed_benchmark.py resolves ../config_mammobench*.json relative to this folder.
WORKDIR /opt/FLamby/flamby/benchmarks
ENTRYPOINT ["python", "fed_benchmark.py", "-cfp", "../config_mammobench.json"]
